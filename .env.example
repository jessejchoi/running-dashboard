# Strava API — from strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# The URL of your deployed app (use http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — from supabase.com project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic — used by RDCoach
ANTHROPIC_API_KEY=your_anthropic_api_key

# Scheduled worker and optional maintenance administrator
CRON_SECRET=replace_with_a_long_random_secret
ADMIN_ATHLETE_ID=

# Independent rollout gates. Keep false until their documented validation passes.
EXPECTED_ESTIMATOR_ENABLED=false
AUTO_ADAPT_ENABLED=false
